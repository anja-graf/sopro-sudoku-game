# This is a sketch for navigating through a sudoku field with arrow keys instead of coordinates
# Note that keyboard module needs to be imported first and on some devices, e.g. Linux the execution requires sudo rights!

import keyboard
from game import Game
import time
from sudoku import *

s = Sudoku()
s.create(Difficulty.EASY)
x = 1
y = 1
print(s)
Game.clear()
print(s.show_blinking_cell(x,y))

ch = keyboard.read_key()
time.sleep(0.5)
while ch != 'enter':
     if ch == 'right':
          y = y + 1
     elif ch == 'left':
          y = y - 1
     elif ch == 'up':
          x = x - 1
     elif ch == 'down':
          x = x + 1
          
     Game.clear()
     print(x,y)
     if not s.is_valid_coordinate(x,y): break
     print(s.show_blinking_cell(x,y))
     ch = keyboard.read_key()
     time.sleep(0.5)